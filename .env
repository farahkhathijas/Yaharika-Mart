# Environment Variables — Yaharika Mart (Development)

# ─── Database ───────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/yaharika-mart

# ─── JWT Auth ───────────────────────────────────────────────
JWT_SECRET=yaharika_jwt_secret_prod_min32_chars_super_secure
JWT_REFRESH_SECRET=yaharika_refresh_secret_prod_min32_chars_super_secure
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Server ─────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ─── Cloudinary (Image Storage) ─────────────────────────────
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=demo
CLOUDINARY_API_SECRET=demo

# ─── Frontend (Next.js public vars) ─────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
NEXT_PUBLIC_APP_NAME=Yaharika Mart
NEXT_PUBLIC_APP_URL=http://localhost:3000
